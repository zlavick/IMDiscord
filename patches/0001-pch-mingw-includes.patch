+// MSVC gets the full SDK include chain below. Under MinGW-w64 windows.h
+// already drags in winsock2, security.h and schannel.h, so defining
+// SECURITY_WIN32 before it (as this block does for MSVC) trips mingw's
+// "#error Do not use SECURITY_WIN32" guard in wincrypt.h. The schannel
+// declarations we need come from <schannel.h>, which pulls security.h in on
+// its own with the right flag set, so under MinGW that is what we include.
+#ifdef _MSC_VER
 #include <winsock2.h>
 #include <ws2tcpip.h>
 #include <windows.h>
@@ -14,6 +21,14 @@
 #define SECURITY_WIN32
 #include <security.h>
 #include <schannel.h>
+#else
+#include <winsock2.h>
